{
  "name": "assurly",
  "version": "1.2.2",
  "description": "Pre-deploy ship gate for AI-built SaaS. Audits npm 12 install-script trust (allowScripts), MCP agent config, Supabase RLS, Stripe webhooks and leaked keys — offline, from files you already have. No upload, no sign-up.",
  "keywords": [
    "allowscripts",
    "install-scripts",
    "postinstall",
    "npm12",
    "supply-chain-security",
    "dependency-audit",
    "lockfile",
    "slopsquat",
    "typosquat",
    "mcp-security",
    "agent-security",
    "prompt-injection",
    "ai-agents",
    "cursor",
    "claude-code",
    "security-scanner",
    "static-analysis",
    "ship-gate",
    "pre-deploy",
    "cli",
    "nextjs",
    "supabase",
    "stripe",
    "vercel",
    "rls",
    "ai-generated-code",
    "vibe-coding",
    "lovable",
    "v0",
    "bolt",
    "replit"
  ],
  "homepage": "https://assurly.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scanProject": {
      "types": "./dist/scanProject.d.ts",
      "default": "./dist/scanProject.js"
    },
    "./ruleExplainer": {
      "types": "./dist/ruleExplainer.d.ts",
      "default": "./dist/ruleExplainer.js"
    }
  },
  "bin": {
    "assurly": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc -w",
    "test": "vitest run src"
  },
  "dependencies": {
    "@assurly/scanner-core": "1.2.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1",
    "ts-morph": "^20.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/assurly/assurly.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Assurly",
  "bugs": {
    "url": "https://assurly.dev/#contact",
    "email": "support@assurly.dev"
  }
}
