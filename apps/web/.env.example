# Canonical application origin used for provider callbacks, Stripe redirects, and CORS.
# Production: must be https://yourdomain.com (no trailing slash)
APP_URL=http://localhost:3000

# Supabase – public keys exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase – server-only service role key (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe – server-only credentials.
# SECURITY: Use restricted keys with only the required permissions.
# Never use the live secret key in development; use test keys (sk_test_...) instead.
# Rotate immediately at https://dashboard.stripe.com/apikeys if ever exposed.
STRIPE_SECRET_KEY=

# Webhook signing secret – prevents spoofed webhook delivery.
# Dashboard: Developers → Webhooks → your endpoint → Signing secret
# Local dev:  stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# GitHub App credentials. GITHUB_STATE_SECRET must be a random 32+ byte value.
# Optional server PAT/token fallbacks used when the GitHub App is not installed.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PAT=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_STATE_SECRET=
NEXT_PUBLIC_GITHUB_APP_NAME=

# Local perf baseline runs (set to 1 for Playwright perf fixtures only).
PERF_BASELINE=

# Optional Postgres URL referenced by manual-checker demo snippets only.
DATABASE_URL=

# Stripe publishable key for client-side checkout (if using @stripe/stripe-js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# HMAC key used to pseudonymize IP and user identities for rate limiting.
RATE_LIMIT_SECRET=

# Contact / transactional email delivery via Resend.
# CONTACT_SIMULATION_ENABLED=true skips delivery and logs to console (dev only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=ShipReady Alerts <onboarding@resend.dev>
SUPPORT_EMAIL=support@shipready.dev
CONTACT_SIMULATION_ENABLED=false

# GitHub webhook scanner budget. Truncation is always reported as an incomplete scan finding.
SCANNER_MAX_FILES=100

# Anthropic API key for the optional AI layer (plain-language consequences, later
# the red-team planner). AI is NEVER on the critical path: when this is unset,
# consequences fall back to the curated map and scans still complete normally.
ANTHROPIC_API_KEY=

# Per-org monthly AI token ceiling (guards cost before real accounting lands).
AI_MONTHLY_TOKEN_CAP=2000000

# Shared secret gating Vercel Cron requests (Authorization: Bearer <value>).
CRON_SECRET=

# Shared secret gating the internal exit-readiness metrics endpoint (owner/acquirer only).
METRICS_SECRET=

# HMAC secret used to derive ownership-verification tokens for scan-url targets.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset; required in production.
OWNERSHIP_TOKEN_SECRET=

# Signing secret for the Vercel account/deploy webhook (x-vercel-signature).
VERCEL_WEBHOOK_SECRET=
